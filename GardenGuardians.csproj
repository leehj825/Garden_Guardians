<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===================================================================
       Shared settings (desktop + Android)
       =================================================================== -->
  <PropertyGroup>
    <!-- Desktop (net8.0) is the day-to-day prototyping target; Android is
         built by CI. Pass -p:DesktopOnly=true to skip Android on machines
         that don't have the 'android' workload installed. -->
    <TargetFrameworks>net8.0;net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(DesktopOnly)' == 'true'">net8.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GardenGuardians</RootNamespace>
    <!-- BramblekinModel manages its own native bone-matrix buffers per instance (see its doc comment). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-android'">
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <!-- Desktop reads these straight off disk (relative to the working
         directory), so they just need to land next to the built exe. -->
    <None Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Files under a project's "Assets" folder are AndroidAsset items by the
       .NET Android SDK's own default glob — same convention as "Resources"
       for AndroidResource — so nothing extra is needed to package them
       there; raylib's own AAssetManager hookup reads them straight out of
       the APK the same way it already does for everything else raylib
       loads on that platform (see BramblekinModel's Android asset path,
       which drops the "Assets/" prefix the SDK itself strips on packaging).
       An explicit <AndroidAsset Include="Assets/**" /> here would just
       duplicate that default glob. -->

  <!-- On Android, take only the managed bindings. The package's native
       binaries are desktop builds, and NuGet treats android-x64 as a kind of
       linux-x64, so without ExcludeAssets the glibc linux-x64 libraylib.so
       would be packed into the APK instead of our NDK build (see below). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <PackageReference Include="Raylib-cs" Version="8.1.0" ExcludeAssets="native" />
  </ItemGroup>

  <!-- ===================================================================
       Android-only settings
       =================================================================== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.gardenguardians.game</ApplicationId>
    <ApplicationTitle>Garden Guardians</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>

    <!-- Always produce a sideloadable .apk (Release would default to .aab). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Only the ABIs build-raylib.sh compiles libraylib.so for: real phones
         (arm64) and the x86_64 emulator. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>

    <!-- MainActivity passes a C# function pointer to native code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Optimize even the Debug APKs CI builds for testing: unoptimized, the
         garden simulates about 2.7x slower (42x vs 115x real time on a
         desktop), and fast-forward on a phone can't keep up. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Release APKs run the same code the tested Debug APKs do: optimized
       JIT, nothing trimmed and nothing compiled ahead of time. Trimming
       and AOT change what runs on the phone (the save reads and writes
       World's fields by reflection) and can't be tried out before main. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android' And '$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <!-- Ahead-of-time compile the game (and the libraries it uses) with LLVM, in
       Debug and Release alike. Left to the JIT, the phone runs the simulation
       several times slower than a desktop and fast-forward can't keep up
       (about 12x when set to 50x on a large garden). Nothing is trimmed, so
       the save's use of reflection still finds everything. The whole-app
       profile is not used: it would leave methods to the JIT. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <EnableLLVM>true</EnableLLVM>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- Android entry point (MainActivity) is only compiled for Android. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-android'">
    <Compile Remove="Platforms/Android/**" />
  </ItemGroup>

  <!-- Raylib-cs P/Invokes into "raylib", which Android resolves as
       libraylib.so. The NuGet package has no Android build, so
       Platforms/Android/build-raylib.sh compiles one per ABI into
       Platforms/Android/libs/<abi>/ (the ABI is inferred from the folder). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidNativeLibrary Include="Platforms/Android/libs/arm64-v8a/libraylib.so" />
    <AndroidNativeLibrary Include="Platforms/Android/libs/x86_64/libraylib.so" />
  </ItemGroup>

  <!-- Without libraylib.so the APK would build fine and crash on launch, so
       stop the build early with instructions instead. -->
  <Target Name="EnsureAndroidRaylib" BeforeTargets="BeforeBuild"
          Condition="'$(TargetFramework)' == 'net8.0-android'">
    <Error Condition="!Exists('%(AndroidNativeLibrary.FullPath)')"
           Text="Missing native raylib for Android: %(AndroidNativeLibrary.Identity). Run Platforms/Android/build-raylib.sh first (requires the Android NDK)." />
  </Target>

</Project>
