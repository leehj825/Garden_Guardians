<Project Sdk="Microsoft.NET.Sdk">

  <!-- A throwaway diagnostic app: one plain Android screen with Google's test banner, nothing else. Its package name differs from the
       game's, and it uses Google's own sample app id, so if a test ad shows here but not in the game, Google is refusing the game's
       package (or its setup); if it fails here too, the cause is in the .NET / SDK setup or the device. Built by debug-build.yml. -->
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AdTest</RootNamespace>
    <ApplicationId>com.gardenguardians.adtest</ApplicationId>
    <ApplicationTitle>GG Ad Test</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same ads packages as the game (GardenGuardians.csproj). -->
    <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.5.0" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing" Version="2.0.0" />
  </ItemGroup>

</Project>
